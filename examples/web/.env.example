# Demo Sanity project used by this example app. Access isn't provisioned
# yet for external contributors — the app is designed to build and boot
# without these set (see lib/sanity.ts), so copy this file to `.env.local`
# only once you have (or have created) a dataset to point at.
NEXT_PUBLIC_SANITY_PROJECT_ID=2xpymzdv
NEXT_PUBLIC_SANITY_DATASET=production
